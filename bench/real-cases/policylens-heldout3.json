   },
   "note": "before/after are the PolicyVersion.Document objects from the MAMIP files, unchanged."
  },
  "before": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Effect": "Allow",
     "Action": [
      "dataexchange:Get*",
      "dataexchange:List*"
     ],
     "Resource": "*"
    },
    {
     "Effect": "Allow",
     "Action": [
      "dataexchange:CreateJob",
      "dataexchange:StartJob",
      "dataexchange:CancelJob"
     ],
     "Resource": "*",
     "Condition": {
