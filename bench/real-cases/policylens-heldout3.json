 {
  "id": "PLH3-A14",
  "title": "Condition operator change: Bool -> BoolIfExists on aws:MultiFactorAuthPresent for iam:*",
  "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_IfExists",
  "kind": "modelled",
  "sources": [
   "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_condition_operators.html#Conditions_IfExists",
   "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-multifactorauthpresent",
   "https://docs.aws.amazon.com/IAM/latest/UserGuide/id_credentials_mfa_configure-api-require.html"
  ],
  "note": "Modelled admin policy; the only change is the operator.",
  "before": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Sid": "IamAdminWithMfa",
     "Effect": "Allow",
     "Action": "iam:*",
     "Resource": "*",
     "Condition": {
      "Bool": {
       "aws:MultiFactorAuthPresent": "true"
      }
     }
    }
   ]
  },
  "after": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Sid": "IamAdminWithMfa",
     "Effect": "Allow",
     "Action": "iam:*",
     "Resource": "*",
     "Condition": {
      "BoolIfExists": {
       "aws:MultiFactorAuthPresent": "true"
      }
     }
    }
   ]
  },
  "principal": "arn:aws:iam::111122223333:user/iam-admin (long-term access key, no MFA)",
  "expect": {
   "status": "stop",
   "why": "With Bool, a missing key makes the condition false (operators doc), so requests signed with long-term access keys, where aws:MultiFactorAuthPresent is absent, are denied. With BoolIfExists, 'If the key is not present, evaluate the condition element as true'. Every access-key call to iam:* now goes ImplicitDeny -> Allow without MFA. Only console/STS sessions that report false are still blocked. The MFA guard on full IAM admin is effectively bypassed for programmatic use."
  },
  "doubt": "Some teams use BoolIfExists on purpose to allow CLI keys; by IAM semantics it still removes the MFA requirement for those calls."
 },
