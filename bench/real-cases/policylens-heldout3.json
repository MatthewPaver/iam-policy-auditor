 {
  "id": "PLH3-A06",
  "title": "ECR repository policy: image pull opened from two named users to Principal \"*\"",
  "source": "https://docs.aws.amazon.com/AmazonECR/latest/userguide/repository-policy-examples.html",
  "kind": "modelled",
  "policyType": "ECR repository policy",
  "sources": [
   "https://docs.aws.amazon.com/AmazonECR/latest/userguide/repository-policy-examples.html",
   "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_principal.html#principal-anonymous",
   "https://docs.aws.amazon.com/securityhub/latest/userguide/ecr-controls.html"
  ],
  "note": "Before is the ECR doc example with AllowPull + AllowAll (placeholders resolved). After changes only AllowPull's Principal to \"*\".",
  "before": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Sid": "AllowPull",
     "Effect": "Allow",
     "Principal": {
      "AWS": [
       "arn:aws:iam::111122223333:user/pull-user-1",
       "arn:aws:iam::111122223333:user/pull-user-2"
      ]
     },
     "Action": [
      "ecr:BatchGetImage",
      "ecr:GetDownloadUrlForLayer"
     ],
     "Resource": "*"
    },
    {
     "Sid": "AllowAll",
     "Effect": "Allow",
     "Principal": {
      "AWS": "arn:aws:iam::111122223333:user/admin-user"
     },
     "Action": [
      "ecr:*"
     ],
     "Resource": "*"
    }
   ]
  },
  "after": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Sid": "AllowPull",
     "Effect": "Allow",
     "Principal": "*",
     "Action": [
      "ecr:BatchGetImage",
      "ecr:GetDownloadUrlForLayer"
     ],
     "Resource": "*"
    },
    {
     "Sid": "AllowAll",
     "Effect": "Allow",
     "Principal": {
      "AWS": "arn:aws:iam::111122223333:user/admin-user"
     },
     "Action": [
      "ecr:*"
     ],
     "Resource": "*"
    }
   ]
  },
  "principal": "arn:aws:iam::999999999999:user/anyone",
  "expect": {
   "status": "stop",
   "why": "Principal \"*\" with no condition lets any principal in any AWS account call ecr:BatchGetImage and ecr:GetDownloadUrlForLayer. They need only ecr:GetAuthorizationToken in their own account. Pulling the private images (which often contain code and embedded configuration) goes ImplicitDeny -> Allow for every other account."
  }
 },
 {
  "id": "PLH3-A07",
  "title": "Lambda function resource policy: invoke widened from two named principals to Principal \"*\"",
  "source": "https://docs.aws.amazon.com/lambda/latest/dg/permissions-function-cross-account.html",
  "kind": "modelled",
  "policyType": "Lambda resource-based policy",
  "sources": [
   "https://docs.aws.amazon.com/lambda/latest/dg/permissions-function-cross-account.html",
   "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_elements_principal.html#principal-anonymous",
   "https://docs.aws.amazon.com/securityhub/latest/userguide/lambda-controls.html"
  ],
  "note": "Before is the Lambda doc's cross-account example verbatim. After replaces the principal list with \"*\".",
  "before": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Sid": "allow-account-invoke",
     "Effect": "Allow",
     "Principal": {
      "AWS": [
       "arn:aws:iam::111122223333:root",
       "arn:aws:iam::444455556666:role/cross-account-role"
      ]
     },
     "Action": "lambda:InvokeFunction",
     "Resource": "arn:aws:lambda:us-east-2:123456789012:function:my-function"
    }
   ]
  },
  "after": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Sid": "allow-account-invoke",
     "Effect": "Allow",
     "Principal": "*",
     "Action": "lambda:InvokeFunction",
     "Resource": "arn:aws:lambda:us-east-2:123456789012:function:my-function"
    }
   ]
  },
  "principal": "arn:aws:iam::999999999999:role/anyone",
  "expect": {
   "status": "stop",
   "why": "Before, only account 111122223333 and one named role in 444455556666 can invoke my-function. After, Principal \"*\" with no condition makes the function publicly invocable by any AWS principal. Invoke from any other account goes ImplicitDeny -> Allow, and the function runs with its own execution role. Security Hub Lambda.1 flags exactly this."
  }
 },
 {
  "id": "PLH3-A08",
