        "WebServers"
       ]
      }
     }
    }
   ]
  },
  "principal": "arn:aws:iam::111122223333:user/finance-ops",
  "expect": {
   "status": "review",
   "why": "SendCommand is newly allowed with any document, including AWS-RunShellScript, so commands are arbitrary. But the instance side applies only where ssm:resourceTag/Finance matches WebServers, so for other nodes the doc says 'the execution results show AccessDenied'. This is remote execution conditional on resource tags: whether a request is allowed depends on tag values outside the policy, and on who can set those tags."
  },
  "doubt": "Arbitrary commands on the tagged fleet could be judged 'stop', especially if the principal can tag instances."
 },
