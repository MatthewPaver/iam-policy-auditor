  "source": "https://docs.aws.amazon.com/secretsmanager/latest/userguide/auth-and-access_examples_cross.html",
  "kind": "modelled",
  "policyType": "Secrets Manager resource policy",
  "sources": [
   "https://docs.aws.amazon.com/secretsmanager/latest/userguide/auth-and-access_examples_cross.html",
   "https://docs.aws.amazon.com/secretsmanager/latest/userguide/auth-and-access_resource-policies.html"
  ],
  "note": "Before is the Secrets Manager doc's Step 1 policy verbatim (the secret is in another account; ApplicationRole is in 111122223333). After adds PutResourcePolicy.",
  "before": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Effect": "Allow",
     "Principal": {
      "AWS": "arn:aws:iam::111122223333:role/ApplicationRole"
     },
     "Action": "secretsmanager:GetSecretValue",
     "Resource": "*"
    }
   ]
  },
  "after": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Effect": "Allow",
     "Principal": {
      "AWS": "arn:aws:iam::111122223333:role/ApplicationRole"
     },
     "Action": [
      "secretsmanager:GetSecretValue",
      "secretsmanager:PutResourcePolicy"
     ],
     "Resource": "*"
    }
   ]
  },
  "principal": "arn:aws:iam::111122223333:role/ApplicationRole",
  "expect": {
   "status": "stop",
   "why": "The external role can already read the secret value. After, it can also rewrite the secret's resource policy: PutResourcePolicy is in the cross-account-effective list and goes ImplicitDeny -> Allow. The Secrets Manager doc warns that granting PutResourcePolicy 'lets principals escalate existing permissions like obtaining full administrative access to secrets'. A cross-account principal can now grant itself, or anyone, any secret operation."
  }
 },
 {
  "id": "PLH3-A09",
  "title": "ssm:SendCommand added with any document, but only on instances tagged Finance=WebServers",
  "source": "https://docs.aws.amazon.com/systems-manager/latest/userguide/run-command-setting-up.html#tag-based-access",
  "kind": "modelled",
  "sources": [
   "https://docs.aws.amazon.com/systems-manager/latest/userguide/run-command-setting-up.html#tag-based-access",
   "https://docs.aws.amazon.com/service-authorization/latest/reference/list_awssystemsmanager.html"
  ],
  "note": "After adds the two SendCommand statements from the Run Command doc's tag-based example verbatim.",
  "before": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Sid": "RunCommandRead",
     "Effect": "Allow",
     "Action": [
      "ssm:ListCommands",
      "ssm:ListCommandInvocations",
      "ssm:GetDocument"
     ],
     "Resource": "*"
    }
   ]
  },
  "after": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Sid": "RunCommandRead",
     "Effect": "Allow",
     "Action": [
      "ssm:ListCommands",
      "ssm:ListCommandInvocations",
      "ssm:GetDocument"
     ],
     "Resource": "*"
    },
    {
     "Effect": "Allow",
     "Action": [
      "ssm:SendCommand"
     ],
     "Resource": [
      "arn:aws:ssm:*:*:document/*"
     ]
    },
    {
     "Effect": "Allow",
     "Action": [
      "ssm:SendCommand"
     ],
     "Resource": [
      "arn:aws:ec2:*:*:instance/*"
