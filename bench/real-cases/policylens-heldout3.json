      "kms:ListAliases",
      "kms:ListKeys"
     ],
     "Resource": "*"
    }
   ]
  },
  "after": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Effect": "Allow",
     "Action": [
      "dataexchange:Get*",
      "dataexchange:List*"
     ],
     "Resource": "*"
    },
    {
     "Effect": "Allow",
     "Action": [
      "dataexchange:CreateJob",
      "dataexchange:StartJob",
      "dataexchange:CancelJob"
     ],
     "Resource": "*",
     "Condition": {
      "StringEquals": {
       "dataexchange:JobType": [
        "EXPORT_ASSETS_TO_S3",
        "EXPORT_ASSET_TO_SIGNED_URL"
       ]
      }
     }
    },
    {
     "Action": "s3:GetObject",
     "Effect": "Allow",
     "Resource": "arn:aws:s3:::*aws-data-exchange*",
     "Condition": {
      "ForAnyValue:StringEquals": {
       "aws:CalledVia": [
        "dataexchange.amazonaws.com"
       ]
      }
     }
    },
    {
     "Effect": "Allow",
     "Action": [
      "s3:GetBucketLocation",
      "s3:ListBucket",
      "s3:ListAllMyBuckets"
     ],
     "Resource": "*"
    },
    {
     "Effect": "Allow",
     "Action": [
      "aws-marketplace:Subscribe",
      "aws-marketplace:Unsubscribe",
      "aws-marketplace:ViewSubscriptions",
      "aws-marketplace:GetAgreementRequest",
      "aws-marketplace:ListAgreementRequests",
      "aws-marketplace:CancelAgreementRequest"
     ],
     "Resource": "*"
    },
    {
     "Effect": "Allow",
     "Action": [
      "kms:DescribeKey",
      "kms:ListAliases",
      "kms:ListKeys"
     ],
     "Resource": "*"
    }
   ]
  },
  "expect": {
   "status": "pass",
   "why": "The only edit adds Condition ForAnyValue:StringEquals aws:CalledVia = dataexchange.amazonaws.com to the existing s3:GetObject on arn:aws:s3:::*aws-data-exchange* statement. A new condition on an Allow can only remove matches. Direct GetObject calls are now implicitly denied, and calls made through Data Exchange are unchanged. Nothing is newly allowed."
  },
  "sources": [
   "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_condition-keys.html#condition-keys-calledvia",
   "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_evaluation-logic.html"
  ],
  "note": "False-positive test: the diff touches an s3:GetObject statement."
