  "source": "https://github.com/zoph-io/IAMTrail/blob/173745fc481d406d5bf1742c9f9f7859399373f7/policies/AWSFaultInjectionSimulatorSSMAccess",
  "kind": "real",
  "sourceDetail": {
   "policyArn": "arn:aws:iam::aws:policy/AWSFaultInjectionSimulatorSSMAccess",
   "repo": "https://github.com/zoph-io/IAMTrail (formerly zoph-io/MAMIP)",
   "before": {
    "versionId": "v1",
    "createDate": "2022-10-26T15:33:44Z",
    "commit": "3884a4c4b8de4ceb865adb8ae5a1e93d4003108a",
    "url": "https://github.com/zoph-io/IAMTrail/blob/3884a4c4b8de4ceb865adb8ae5a1e93d4003108a/policies/AWSFaultInjectionSimulatorSSMAccess"
   },
   "after": {
    "versionId": "v2",
    "createDate": "2023-06-02T22:55:18Z",
    "commit": "173745fc481d406d5bf1742c9f9f7859399373f7",
    "url": "https://github.com/zoph-io/IAMTrail/blob/173745fc481d406d5bf1742c9f9f7859399373f7/policies/AWSFaultInjectionSimulatorSSMAccess"
   },
   "note": "before/after are the PolicyVersion.Document objects from the MAMIP files, unchanged."
  },
  "before": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Effect": "Allow",
     "Action": "iam:PassRole",
     "Resource": "arn:aws:iam::*:role/*",
     "Condition": {
      "StringEquals": {
       "iam:PassedToService": "ssm.amazonaws.com"
      }
     }
    },
    {
     "Effect": "Allow",
     "Action": [
      "ssm:StartAutomationExecution"
     ],
     "Resource": [
      "arn:aws:ssm:*:*:automation-definition/*:*"
     ]
    },
    {
     "Effect": "Allow",
     "Action": [
      "ssm:GetAutomationExecution",
      "ssm:StopAutomationExecution"
     ],
     "Resource": [
      "arn:aws:ssm:*:*:automation-execution/*"
     ]
    }
   ]
  },
  "after": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Effect": "Allow",
     "Action": "iam:PassRole",
     "Resource": "arn:aws:iam::*:role/*",
     "Condition": {
      "StringEquals": {
       "iam:PassedToService": "ssm.amazonaws.com"
      }
     }
    },
    {
     "Effect": "Allow",
     "Action": [
      "ssm:StartAutomationExecution"
     ],
     "Resource": [
      "arn:aws:ssm:*:*:automation-definition/*:*"
     ]
    },
    {
     "Effect": "Allow",
     "Action": [
      "ssm:GetAutomationExecution",
      "ssm:StopAutomationExecution"
     ],
     "Resource": [
      "arn:aws:ssm:*:*:automation-execution/*"
     ]
    },
    {
     "Effect": "Allow",
     "Action": "ssm:SendCommand",
     "Resource": [
      "arn:aws:ec2:*:*:instance/*",
      "arn:aws:ssm:*:*:document/*"
     ]
    },
    {
     "Effect": "Allow",
     "Action": [
      "ssm:ListCommands",
      "ssm:CancelCommand"
     ],
     "Resource": "*"
    }
   ]
  },
  "expect": {
   "status": "stop",
   "why": "v1 allows only SSM Automation (StartAutomationExecution on automation-definition/*, Get/StopAutomationExecution) plus iam:PassRole limited to iam:PassedToService = ssm.amazonaws.com. v2 adds an unconditioned statement: ssm:SendCommand on arn:aws:ec2:*:*:instance/* and arn:aws:ssm:*:*:document/*. That allows running any SSM document, including AWS-RunShellScript, on every managed instance. SendCommand goes ImplicitDeny -> Allow. Running arbitrary commands on instances gives code execution with each instance profile's credentials."
  },
  "sources": [
   "https://docs.aws.amazon.com/systems-manager/latest/userguide/run-command.html",
   "https://docs.aws.amazon.com/service-authorization/latest/reference/list_awssystemsmanager.html",
   "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_evaluation-logic.html"
  ],
  "principal": "arn:aws:iam::111122223333:role/fis-experiment-role"
 },
