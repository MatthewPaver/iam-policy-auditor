 {
  "id": "PLH2-A10",
  "title": "Rhino method 20: iam:PassRole on * added next to an existing cloudformation:CreateStack",
  "source": "https://rhinosecuritylabs.com/aws/aws-privilege-escalation-methods-mitigation/",
  "kind": "modelled",
  "rhinoMethod": 20,
  "note": "Modelled: Rhino publishes permission combinations, not policies. Before/after are minimal identity policies attached to the principal. Account 111122223333 is an AWS documentation placeholder.",
  "sources": [
   "https://rhinosecuritylabs.com/aws/aws-privilege-escalation-methods-mitigation/",
   "https://docs.aws.amazon.com/AWSCloudFormation/latest/UserGuide/using-iam-servicerole.html",
   "https://docs.aws.amazon.com/IAM/latest/UserGuide/id_roles_use_passrole.html"
  ],
  "before": {
   "Version": "2012-10-17",
   "Statement": [
    {
     "Sid": "DeployAppStacks",
