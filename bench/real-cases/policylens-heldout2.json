 {
  "id": "PLH2-A12",
  "title": "KMS key policy: cryptographic use opened to another AWS account",
  "source": "https://docs.aws.amazon.com/kms/latest/developerguide/key-policy-modifying-external-accounts.html",
  "kind": "modelled",
  "policyType": "KMS key policy",
  "sources": [
   "https://docs.aws.amazon.com/kms/latest/developerguide/key-policy-modifying-external-accounts.html",
   "https://docs.aws.amazon.com/kms/latest/developerguide/key-policy-default.html",
   "https://docs.aws.amazon.com/securityhub/latest/userguide/kms-controls.html"
  ],
  "note": "Before is the default key policy statement for account 111122223333. After adds the AWS doc's external-account statement verbatim (placeholders resolved).",
  "before": {
   "Version": "2012-10-17",
   "Id": "key-default-1",
   "Statement": [
    {
     "Sid": "Enable IAM User Permissions",
     "Effect": "Allow",
     "Principal": {
      "AWS": "arn:aws:iam::111122223333:root"
     },
     "Action": "kms:*",
     "Resource": "*"
    }
   ]
  },
  "after": {
   "Version": "2012-10-17",
   "Id": "key-default-1",
   "Statement": [
    {
     "Sid": "Enable IAM User Permissions",
     "Effect": "Allow",
     "Principal": {
      "AWS": "arn:aws:iam::111122223333:root"
     },
     "Action": "kms:*",
     "Resource": "*"
    },
    {
     "Sid": "Allow an external account to use this KMS key",
     "Effect": "Allow",
     "Principal": {
      "AWS": [
       "arn:aws:iam::444455556666:root"
      ]
     },
     "Action": [
      "kms:Encrypt",
      "kms:Decrypt",
      "kms:ReEncrypt*",
      "kms:GenerateDataKey*",
      "kms:DescribeKey"
     ],
     "Resource": "*"
    }
   ]
  },
  "principal": "arn:aws:iam::444455556666:role/any-role-in-partner-account",
  "expect": {
   "status": "stop",
   "why": "Before, only account 111122223333 (through its IAM policies) can use the key. After, kms:Decrypt, ReEncrypt*, GenerateDataKey* and Encrypt are allowed for account 444455556666, whose IAM admins can delegate them to any of their users or roles. Cross-account Decrypt goes ImplicitDeny -> Allow, so anything encrypted under the key, such as S3 objects, EBS snapshots or secrets, becomes readable by another account. The KMS doc says the key policy 'determines who can have access'."
  }
 },
 {
