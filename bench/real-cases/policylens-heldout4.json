  {
    "id": "PLH4-A06",
    "title": "S3 object-tag restriction removed for a named role",
    "source": "https://docs.aws.amazon.com/AmazonS3/latest/userguide/tagging-and-policies.html",
    "kind": "modelled",
    "before": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Principal": {
            "AWS": [
              "arn:aws:iam::111122223333:role/JohnDoe"
            ]
          },
          "Effect": "Allow",
          "Action": [
            "s3:GetObject",
            "s3:GetObjectVersion"
          ],
          "Resource": "arn:aws:s3:::amzn-s3-demo-bucket/*",
          "Condition": {
            "StringEquals": {
              "s3:ExistingObjectTag/environment": "production"
            }
          }
        }
      ]
    },
    "after": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Principal": {
            "AWS": [
              "arn:aws:iam::111122223333:role/JohnDoe"
            ]
          },
          "Effect": "Allow",
          "Action": [
            "s3:GetObject",
            "s3:GetObjectVersion"
          ],
          "Resource": "arn:aws:s3:::amzn-s3-demo-bucket/*"
        }
      ]
    },
    "expect": {
      "status": "stop",
      "why": "Removing the production object-tag condition newly permits reading objects of every environment within the example bucket. The named principal and bucket scope do not preserve the removed data boundary."
    },
    "sourceDetail": {
      "note": "Modelled counterfactual, not a deployed policy or incident. Before is the first AWS example verbatim. After deletes only its Condition."
    }
  },
