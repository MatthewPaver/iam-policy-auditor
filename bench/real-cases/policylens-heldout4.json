  {
    "id": "PLH4-A11",
    "title": "MFA explicit deny hardened to cover an absent MFA context key",
    "source": "https://docs.aws.amazon.com/IAM/latest/UserGuide/reference_policies_examples_iam_mfa-selfmanage.html",
    "kind": "modelled",
    "before": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "AllowListActions",
          "Effect": "Allow",
          "Action": [
            "iam:ListUsers",
            "iam:ListVirtualMFADevices"
          ],
          "Resource": "*"
        },
        {
          "Sid": "AllowUserToCreateVirtualMFADevice",
          "Effect": "Allow",
          "Action": [
            "iam:CreateVirtualMFADevice"
          ],
          "Resource": "arn:aws:iam::*:mfa/*"
        },
        {
          "Sid": "AllowUserToManageTheirOwnMFA",
          "Effect": "Allow",
          "Action": [
            "iam:EnableMFADevice",
            "iam:GetMFADevice",
            "iam:ListMFADevices",
            "iam:ResyncMFADevice"
          ],
          "Resource": "arn:aws:iam::*:user/${aws:username}"
        },
        {
          "Sid": "AllowUserToDeactivateTheirOwnMFAOnlyWhenUsingMFA",
          "Effect": "Allow",
          "Action": [
            "iam:DeactivateMFADevice"
          ],
          "Resource": [
            "arn:aws:iam::*:user/${aws:username}"
          ],
          "Condition": {
            "Bool": {
              "aws:MultiFactorAuthPresent": "true"
            }
          }
        },
        {
          "Sid": "BlockMostAccessUnlessSignedInWithMFA",
          "Effect": "Deny",
          "NotAction": [
            "iam:CreateVirtualMFADevice",
            "iam:EnableMFADevice",
            "iam:ListMFADevices",
            "iam:ListUsers",
            "iam:ListVirtualMFADevices",
            "iam:ResyncMFADevice"
          ],
          "Resource": "*",
          "Condition": {
            "Bool": {
              "aws:MultiFactorAuthPresent": "false"
            }
          }
        }
      ]
    },
    "after": {
      "Version": "2012-10-17",
      "Statement": [
        {
          "Sid": "AllowListActions",
          "Effect": "Allow",
          "Action": [
            "iam:ListUsers",
            "iam:ListVirtualMFADevices"
          ],
          "Resource": "*"
        },
        {
          "Sid": "AllowUserToCreateVirtualMFADevice",
          "Effect": "Allow",
          "Action": [
            "iam:CreateVirtualMFADevice"
          ],
          "Resource": "arn:aws:iam::*:mfa/*"
        },
        {
          "Sid": "AllowUserToManageTheirOwnMFA",
          "Effect": "Allow",
          "Action": [
            "iam:EnableMFADevice",
            "iam:GetMFADevice",
            "iam:ListMFADevices",
            "iam:ResyncMFADevice"
          ],
          "Resource": "arn:aws:iam::*:user/${aws:username}"
        },
        {
          "Sid": "AllowUserToDeactivateTheirOwnMFAOnlyWhenUsingMFA",
          "Effect": "Allow",
          "Action": [
            "iam:DeactivateMFADevice"
          ],
          "Resource": [
            "arn:aws:iam::*:user/${aws:username}"
          ],
          "Condition": {
            "Bool": {
              "aws:MultiFactorAuthPresent": "true"
            }
          }
        },
        {
          "Sid": "BlockMostAccessUnlessSignedInWithMFA",
          "Effect": "Deny",
          "NotAction": [
            "iam:CreateVirtualMFADevice",
            "iam:EnableMFADevice",
            "iam:ListMFADevices",
            "iam:ListUsers",
            "iam:ListVirtualMFADevices",
            "iam:ResyncMFADevice"
          ],
          "Resource": "*",
          "Condition": {
            "BoolIfExists": {
              "aws:MultiFactorAuthPresent": "false"
            }
          }
        }
      ]
    },
    "expect": {
      "status": "pass",
      "why": "Restoring BoolIfExists in a Deny makes the MFA restriction also apply when the MFA context key is absent. It cannot newly allow an action. Existing MFA-enrolment exceptions remain unchanged."
    },
    "sourceDetail": {
      "note": "Modelled counterfactual, not a deployed policy or incident. After is the AWS MFA self-management policy verbatim. Before replaces only BoolIfExists with Bool in the final Deny. This reverses the unsafe relaxation rather than modelling an incident."
    }
  },
