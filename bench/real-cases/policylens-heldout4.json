      "Statement": [
        {
          "Effect": "Allow",
          "Action": "sts:AssumeRole",
          "Resource": "arn:aws:iam::123456789012:role/role_i_can_assume"
        },
        {
          "Effect": "Allow",
          "Action": "iam:AttachRolePolicy",
          "Resource": "arn:aws:iam::123456789012:role/role_i_can_assume"
        }
