{
  "_about": "Ground-truth cases for the AWS policy evaluator. Each `expected` decision is derived from AWS's documented IAM evaluation semantics (deny > allow > implicit-deny, wildcard/NotAction/NotResource matching, condition operators). Cases with `oracleSkip` intentionally diverge from AWS SimulateCustomPolicy (which cannot express our informative 'ConditionalAllow') and are excluded from oracle diffing. Policies are stored as objects and stringified by the runner so line citations work.",
  "cases": [
    { "id": "allow-basic", "note": "explicit allow, resource matches",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Sid": "R", "Effect": "Allow", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::data/*" }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/report.csv" }, "expected": "Allow" },

    { "id": "implicit-action-nomatch", "note": "action not granted → implicit deny",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::data/*" }] },
      "request": { "action": "s3:PutObject", "resource": "arn:aws:s3:::data/report.csv" }, "expected": "ImplicitDeny" },

    { "id": "implicit-resource-nomatch", "note": "resource outside grant → implicit deny",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": "arn:aws:s3:::data/*" }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::secrets/x" }, "expected": "ImplicitDeny" },

    { "id": "explicit-deny-overrides", "note": "deny beats allow",
      "policy": { "Version": "2012-10-17", "Statement": [
        { "Effect": "Allow", "Action": "s3:*", "Resource": "*" },
        { "Effect": "Deny", "Action": "s3:DeleteObject", "Resource": "*" }] },
      "request": { "action": "s3:DeleteObject", "resource": "arn:aws:s3:::data/x" }, "expected": "ExplicitDeny" },

    { "id": "admin-star", "note": "Action * Resource * allows anything",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "*", "Resource": "*" }] },
      "request": { "action": "ec2:TerminateInstances", "resource": "*" }, "expected": "Allow" },

    { "id": "service-wildcard-in", "note": "s3:* covers s3:DeleteObject",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:*", "Resource": "*" }] },
      "request": { "action": "s3:DeleteObject", "resource": "arn:aws:s3:::data/x" }, "expected": "Allow" },

    { "id": "service-wildcard-out", "note": "s3:* does not cover ec2",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:*", "Resource": "*" }] },
      "request": { "action": "ec2:RunInstances", "resource": "*" }, "expected": "ImplicitDeny" },

    { "id": "notaction-allow-included", "note": "Allow+NotAction grants everything not listed",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "NotAction": "iam:*", "Resource": "*" }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x" }, "expected": "Allow" },

    { "id": "notaction-allow-excluded", "note": "action in NotAction set is NOT granted",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "NotAction": "iam:*", "Resource": "*" }] },
      "request": { "action": "iam:CreateUser", "resource": "*" }, "expected": "ImplicitDeny" },

    { "id": "ip-in-range", "note": "IpAddress condition satisfied",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": "*", "Condition": { "IpAddress": { "aws:SourceIp": "10.0.0.0/8" } } }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x", "context": { "aws:SourceIp": "10.1.2.3" } }, "expected": "Allow" },

    { "id": "ip-out-of-range", "note": "IpAddress condition fails → statement inapplicable",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": "*", "Condition": { "IpAddress": { "aws:SourceIp": "10.0.0.0/8" } } }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x", "context": { "aws:SourceIp": "203.0.113.5" } }, "expected": "ImplicitDeny" },

    { "id": "mfa-deny-triggers", "note": "deny-if-no-MFA fires when MFA absent",
      "policy": { "Version": "2012-10-17", "Statement": [
        { "Effect": "Allow", "Action": "s3:*", "Resource": "*" },
        { "Effect": "Deny", "Action": "s3:*", "Resource": "*", "Condition": { "Bool": { "aws:MultiFactorAuthPresent": "false" } } }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x", "context": { "aws:MultiFactorAuthPresent": "false" } }, "expected": "ExplicitDeny" },

    { "id": "mfa-deny-inert", "note": "same policy, MFA present → allowed",
      "policy": { "Version": "2012-10-17", "Statement": [
        { "Effect": "Allow", "Action": "s3:*", "Resource": "*" },
        { "Effect": "Deny", "Action": "s3:*", "Resource": "*", "Condition": { "Bool": { "aws:MultiFactorAuthPresent": "false" } } }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x", "context": { "aws:MultiFactorAuthPresent": "true" } }, "expected": "Allow" },

    { "id": "orgid-match", "note": "StringEquals PrincipalOrgID matches",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": "*", "Condition": { "StringEquals": { "aws:PrincipalOrgID": "o-abc123" } } }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x", "context": { "aws:PrincipalOrgID": "o-abc123" } }, "expected": "Allow" },

    { "id": "orgid-mismatch", "note": "StringEquals PrincipalOrgID differs",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": "*", "Condition": { "StringEquals": { "aws:PrincipalOrgID": "o-abc123" } } }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x", "context": { "aws:PrincipalOrgID": "o-zzz999" } }, "expected": "ImplicitDeny" },

    { "id": "stringlike-match", "note": "StringLike wildcard on userid",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": "*", "Condition": { "StringLike": { "aws:userid": "AIDA*" } } }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x", "context": { "aws:userid": "AIDAEXAMPLEID" } }, "expected": "Allow" },

    { "id": "arnlike-match", "note": "ArnLike SourceArn",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "sns:Publish", "Resource": "*", "Condition": { "ArnLike": { "aws:SourceArn": "arn:aws:s3:::mybucket" } } }] },
      "request": { "action": "sns:Publish", "resource": "arn:aws:sns:us-east-1:111122223333:topic", "context": { "aws:SourceArn": "arn:aws:s3:::mybucket" } }, "expected": "Allow" },

    { "id": "date-within-window", "note": "DateLessThan not yet expired",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": "*", "Condition": { "DateLessThan": { "aws:CurrentTime": "2030-01-01T00:00:00Z" } } }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x", "context": { "aws:CurrentTime": "2026-06-01T00:00:00Z" } }, "expected": "Allow" },

    { "id": "date-expired", "note": "DateLessThan already passed",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": "*", "Condition": { "DateLessThan": { "aws:CurrentTime": "2020-01-01T00:00:00Z" } } }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x", "context": { "aws:CurrentTime": "2026-06-01T00:00:00Z" } }, "expected": "ImplicitDeny" },

    { "id": "numeric-mfa-age", "note": "NumericLessThan MultiFactorAuthAge within limit",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": "*", "Condition": { "NumericLessThan": { "aws:MultiFactorAuthAge": "3600" } } }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x", "context": { "aws:MultiFactorAuthAge": "1000" } }, "expected": "Allow" },

    { "id": "ifexists-absent-passes", "note": "StringEqualsIfExists with key absent → passes",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": "*", "Condition": { "StringEqualsIfExists": { "aws:PrincipalTag/team": "platform" } } }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x", "context": {} }, "expected": "Allow" },

    { "id": "scoped-deny-nonmatch", "note": "deny scoped to a different resource does not apply",
      "policy": { "Version": "2012-10-17", "Statement": [
        { "Effect": "Allow", "Action": "s3:*", "Resource": "*" },
        { "Effect": "Deny", "Action": "s3:DeleteObject", "Resource": "arn:aws:s3:::locked/*" }] },
      "request": { "action": "s3:DeleteObject", "resource": "arn:aws:s3:::data/x" }, "expected": "Allow" },

    { "id": "missing-key-conditional", "note": "required condition key not supplied — engine surfaces ConditionalAllow instead of silently denying (intentionally diverges from AWS Simulate)",
      "oracleSkip": true, "oracleReason": "SimulateCustomPolicy resolves a missing key to implicitDeny; our ConditionalAllow is deliberately more informative.",
      "policy": { "Version": "2012-10-17", "Statement": [{ "Effect": "Allow", "Action": "s3:GetObject", "Resource": "*", "Condition": { "StringEquals": { "aws:PrincipalTag/team": "platform" } } }] },
      "request": { "action": "s3:GetObject", "resource": "arn:aws:s3:::data/x", "context": {} }, "expected": "ConditionalAllow" }
  ]
}
